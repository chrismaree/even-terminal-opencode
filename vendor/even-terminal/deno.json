{
  "name": "@mrg-keystone/even-terminal",
  "version": "0.8.1",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./bin/cli.js"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run -A bin/cli.js start",
    "check": "deno check mod.ts bin/cli.js"
  },
  "imports": {
    "express": "npm:express@^5.2.1",
    "cors": "npm:cors@^2.8.6",
    "ws": "npm:ws@^8.20.0",
    "yargs": "npm:yargs@^18.0.0",
    "yargs/helpers": "npm:yargs@^18.0.0/helpers",
    "qrcode-terminal": "npm:qrcode-terminal@^0.12.0",
    "@bomb.sh/tab": "npm:@bomb.sh/tab@^0.0.14",
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@^0.2.118"
  },
  "publish": {
    "exclude": [
      "node_modules",
      "*.log",
      "even-terminal-*.log"
    ]
  }
}
